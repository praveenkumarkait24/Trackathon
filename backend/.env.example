# Express Server Port
PORT=5000

# Supabase Configurations
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client App URL (for redirect after Google OAuth and CORS)
FRONTEND_URL=http://localhost:5173

# Google OAuth Credentials (for Google Calendar Sync)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/callback

# SMTP Email Configurations (e.g. Resend, Sendgrid, or standard SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-app-password
EMAIL_FROM=Trackathon <no-reply@yourdomain.com>

# Web Push Notification VAPID Keys (Generate using: npx web-push generate-vapid-keys)
VAPID_SUBJECT=mailto:support@yourdomain.com
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
